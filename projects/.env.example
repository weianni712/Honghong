# 数据库配置
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Coze 集成配置
COZE_WORKLOAD_IDENTITY_API_KEY=your_api_key_here
COZE_INTEGRATION_BASE_URL=https://integration.coze.cn
COZE_INTEGRATION_MODEL_BASE_URL=https://integration.coze.cn/api/v3

# Supabase 配置（可选，用于博客功能）
COZE_SUPABASE_URL=your_supabase_url
COZE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:5000
COZE_PROJECT_ENV=DEV
